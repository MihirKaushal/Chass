VITE_API_URL=http://localhost:8000
# Scanner uses VITE_API_URL/scanner by default; configure its model host on the backend.
# Never put SCANNER_SERVICE_TOKEN in a VITE variable (these are public).
# Optional development-only direct service override:
# VITE_SCANNER_API_URL=http://127.0.0.1:8001
# Optional public readiness endpoint when self-hosting; never include tokens.
# The Chass production URLs are detected automatically.
# VITE_SCANNER_WAKE_URL=https://your-scanner-host.example/ready
