# Local development defaults. Copy to .env only when you need overrides.
PERSISTENCE_BACKEND=sql
DATABASE_URL=sqlite:///backend/chass.db
# Firestore production settings; leave blank while using local SQLite.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
TOKEN_SECRET=replace-with-a-long-random-value
INVITE_TTL_HOURS=24
GAME_IDLE_TTL_HOURS=24
GAME_CLEANUP_INTERVAL_MINUTES=15
# Classic-only Stockfish Match Predictor settings.
MATCH_PREDICTOR_ENGINE_ENABLED=true
STOCKFISH_PATH=.stockfish/stockfish
STOCKFISH_MOVETIME_MS=180
STOCKFISH_HASH_MB=32
STOCKFISH_THREADS=1
STOCKFISH_STARTUP_TIMEOUT_SECONDS=15
STOCKFISH_STARTUP_ATTEMPTS=2
